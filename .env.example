# Firebase configuration (https://console.firebase.google.com -> Project settings)
# Values prefixed with EXPO_PUBLIC_ are inlined into the client bundle.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Web push (Firebase Cloud Messaging) VAPID key — required only for web FCM.
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# Live package tracking — 17TRACK (https://api.17track.net — free 100/month, no card).
# SERVER-SIDE ONLY: no EXPO_PUBLIC_ prefix, so it is NEVER bundled into the app.
# Read only by the Expo Router API route src/app/track+api.ts (the secure proxy).
# Get it at: 17track.net console -> Settings -> Security -> Access Key.
# Leave empty to fall back to carrier deep-links.
SEVENTEENTRACK_API_KEY=
